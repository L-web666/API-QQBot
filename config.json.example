{
  "qq": {
    "app_id": "请填写你的APPID",
    "app_secret": "请填写你的APPSECRET",
    "sandbox": false,
    "reconnect_attempts": 5,
    "reconnect_interval": 10
  },
  "api_key": "请填写你的API密钥",
  "base_url": "https://api.openai.com/v1",
  "model": "请填写模型名称（如 gpt-3.5-turbo）",
  "asr_base_url": "",
  "asr_api_key": "",
  "asr_model": "whisper-1",
  "system_prompt": "你是一个智能、友好的AI助手，请用中文回复用户的问题。",
  "filter": {
    "exact_match_keywords": [],
    "fuzzy_match_keywords": [],
    "exact_match_responses": {},
    "fuzzy_match_responses": {}
  },
  "group": {
    "require_mention": true
  },
  "message": {
    "max_segment_length": 2000,
    "max_queue_size": 10,
    "filter_meaningless": true
  },
  "rate_limit": {
    "enabled": true,
    "interval_seconds": 3
  },
  "sensitive_words": {
    "enabled": false,
    "list": [],
    "replacement": "***",
    "block_input": false
  },
  "context": {
    "max_history": 20,
    "enabled": true
  },
  "log": {
    "max_size_mb": 10
  },
  "hot_reload": {
    "enabled": true,
    "interval_seconds": 10
  },
  "admin": {
    "openids": []
  },
  "alert": {
    "enabled": true,
    "owner_openid": ""
  },
  "schedule": {
    "enabled": true,
    "tasks": []
  },
  "web_admin": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 8666,
    "token": ""
  },
  "command_panel": {
    "enabled": true,
    "commands": [
      {"type": "command", "name": "/帮助", "desc": "显示指令帮助"},
      {"type": "command", "name": "/clear", "desc": "清空当前场景对话历史"},
      {"type": "command", "name": "/转移私聊到群聊", "desc": "把私聊上下文合并到当前群"},
      {"type": "command", "name": "/生成转移码", "desc": "生成身份绑定码（私聊）"},
      {"type": "command", "name": "/绑定转移码", "desc": "绑定身份并转移上下文（群聊）"},
      {"type": "link", "name": "示例链接", "link": "https://example.com"}
    ],
    "c2c": {
      "target_type": "all",
      "user_openids": [],
      "remark": "QQ AI Bot 私聊指令面板"
    },
    "group": {
      "target_type": "specific",
      "group_openids": [],
      "remark": "QQ AI Bot 群聊指令面板"
    }
  },
  "plugins": {
    "enabled": true,
    "dir": "plugins"
  }
}
